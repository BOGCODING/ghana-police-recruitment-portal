# Server Configuration
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/db_name

# Redis (for Rate Limiting/Caching)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
REFRESH_TOKEN_EXPIRES_IN=7d

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="Ghana Police Recruitment" <noreply@gps.gov.gh>

# App URLs
FRONTEND_URL=http://localhost:3000

# Initial Admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change_this_immediately

# Security
INTERNAL_API_KEY=generate_a_long_random_string_here
CAPTCHA_SECRET=your_captcha_server_secret_here
CAPTCHA_BYPASS_KEY=dev_bypass_only_change_this
