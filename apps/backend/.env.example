# Application URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gps_recruitment
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gps_recruitment
DB_USER=postgres
DB_PASSWORD=boneforgames

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@gps-recruitment.gov.gh

# File Upload Configuration
UPLOAD_MAX_SIZE=1048576
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png
UPLOAD_PATH=./uploads

# Super Admin Configuration
SUPER_ADMIN_EMAIL=boneforgames@gmail.com
SUPER_ADMIN_PASSWORD=Bone@123

# Application Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
