{
  "name": "backend",
  "version": "1.0.0",
  "description": "Ghana Police Service Recruitment Portal - Backend API",
  "main": "server.js",
  "scripts": {
    "build": "echo 'No build step for backend'",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seeds/index.js",
    "migrate:reset": "node src/database/migrate.js --reset",
    "lint": "eslint src/",
    "test": "jest --coverage",
    "clean": "rm -rf node_modules dist",
    "prepare": "cd ../.. && husky install apps/backend/.husky",
    "security-scan": "node src/scripts/secrets-scan.js",
    "validate-env": "node src/scripts/validate-env.js",
    "precommit": "lint-staged && pnpm run validate-env"
  },
  "lint-staged": {
    "src/**/*.{js,json}": [
      "eslint --fix",
      "pnpm run security-scan"
    ]
  },
  "dependencies": {
    "@upstash/redis": "^1.36.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.0",
    "cloudinary": "^2.8.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-writer": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.3.2",
    "joi": "^17.13.4",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.14.0",
    "pg": "^8.11.3",
    "pg-pool": "^3.6.1",
    "qrcode": "^1.5.3",
    "rate-limit-redis": "^4.3.1",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.35.0",
    "socket.io": "^4.7.2",
    "streamifier": "^0.1.1",
    "uuid": "^14.0.2",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "eslint": "^8.55.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
