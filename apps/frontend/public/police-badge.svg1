<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">
  <defs>
    <linearGradient id="goldGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FFD700;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#DAA520;stop-opacity:1" />
    </linearGradient>
  </defs>
  <!-- Shield Shape -->
  <path d="M 50,5 L 10,25 V 50 C 10,75 50,95 50,95 C 50,95 90,75 90,50 V 25 L 50,5 Z" 
        fill="url(#goldGradient)" stroke="#8B6508" stroke-width="2" />
  <!-- Inner Details -->
  <circle cx="50" cy="45" r="15" fill="none" stroke="#8B6508" stroke-width="1.5" />
  <path d="M 40,45 L 60,45 M 50,35 L 50,55" stroke="#8B6508" stroke-width="1.5" />
  <!-- Text Curve Effect (Simplified) -->
  <text x="50" y="75" font-family="Arial" font-size="6" text-anchor="middle" fill="#333" font-weight="bold">GHANA POLICE</text>
  <text x="50" y="82" font-family="Arial" font-size="5" text-anchor="middle" fill="#333">SERVICE</text>
</svg>
